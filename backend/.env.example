NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/mindq_certificates

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d

# SMTP is optional for the demo. If not set, "Resend Certificate" is simulated
# (logged to ActivityLogs and returned in the API response) instead of actually emailing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mind Q Systems <no-reply@mindq.example>"

CERTIFICATE_PREFIX=MQHYD
CERTIFICATE_PAD_LENGTH=6
